# Copy to .env (gitignored). Test-mode keys only; the app refuses live keys.
#
# Secret key: server only. A restricted key (rk_test_...) with write access to
# Checkout Sessions limits what a leaked key can do in your sandbox.
STRIPE_SECRET_KEY=
# Publishable key: sent to the browser for Stripe.js. Public by design.
STRIPE_PUBLISHABLE_KEY=
